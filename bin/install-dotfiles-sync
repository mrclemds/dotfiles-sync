#!/bin/sh

set -eu

DEFAULT_RELEASE_URL=https://github.com/mrclemds/dotfiles-sync/releases/latest/download/dotfiles-sync.tgz

die() {
    printf '%s\n' "ERROR: $*" >&2
    exit 1
}

validate_release_url() {
    release_url=$1
    case "$release_url" in
        https://github.com/*/releases/latest/download/*) ;;
        *) die "release URL must be a GitHub HTTPS latest-release asset" ;;
    esac
    release_path=${release_url#https://github.com/}
    release_repo=${release_path%%/releases/latest/download/*}
    release_asset=${release_path##*/}
    case "$release_repo" in
        ''|/*|*/*/*|*/) die "release URL has an invalid repository" ;;
    esac
    printf '%s\n' "$release_asset"
}

download_release_archive() {
    release_url=$1
    archive=$2
    if command -v curl >/dev/null 2>&1; then
        curl --fail --location --proto '=https' --tlsv1.2 --output "$archive" "$release_url" || die "could not download release"
    elif command -v wget >/dev/null 2>&1; then
        wget -O "$archive" "$release_url" || die "could not download release"
    else
        die "release bootstrap requires curl or wget"
    fi
    [ -r "$archive" ] || die "release download did not provide the archive"
}

extract_release_archive() {
    archive=$1
    destination=$2
    tar -tzf "$archive" > "$destination/files" || die "invalid release archive"
    safe_archive=yes
    while IFS= read -r entry; do
        case "$entry" in
            dotfiles-sync/|dotfiles-sync/*)
                case "$entry" in
                    ../*|*/../*|*/..) safe_archive=no; break ;;
                esac
                ;;
            *) safe_archive=no; break ;;
        esac
    done < "$destination/files"
    [ "$safe_archive" = yes ] || die "release archive contains unsafe paths"
    mkdir -p "$destination/extracted"
    tar -xzf "$archive" -C "$destination/extracted" || die "could not extract release archive"
    release_dir=$destination/extracted/dotfiles-sync
    [ -x "$release_dir/bin/dotfiles-sync" ] || die "release archive is missing the CLI"
    [ -x "$release_dir/bin/install-dotfiles-sync" ] || die "release archive is missing the bootstrap"
    sh -n "$release_dir/bin/dotfiles-sync" || die "release shell validation failed"
    sh -n "$release_dir/bin/install-dotfiles-sync" || die "release bootstrap validation failed"
    printf '%s\n' "$release_dir"
}

download_release() {
    release_url=$1
    destination=$2
    release_asset=$(validate_release_url "$release_url")
    mkdir -p "$destination"
    archive=$destination/$release_asset
    download_release_archive "$release_url" "$archive"
    extract_release_archive "$archive" "$destination"
}

if [ "${1:-}" = --download-release ]; then
    [ "$#" -eq 3 ] || die "usage: install-dotfiles-sync --download-release URL DIRECTORY"
    download_release "$2" "$3"
    exit 0
fi

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-sync-install.XXXXXX") || die "could not create temporary directory"
trap 'rm -rf "$work_dir"' 0 1 2 3 15
release_dir=$(download_release "$DEFAULT_RELEASE_URL" "$work_dir")
"$release_dir/bin/dotfiles-sync" install "$@"
