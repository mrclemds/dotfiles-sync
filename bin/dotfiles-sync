#!/bin/sh
# Pull and apply the configured dotfiles repository.

set -eu

CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles-sync
CONFIG_FILE=${DOTFILES_SYNC_CONFIG:-$CONFIG_DIR/config}
CONFIG_DIR=$(dirname "$CONFIG_FILE")
STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-sync
LOG_FILE=$STATE_DIR/sync.log
PID_FILE=$STATE_DIR/daemon.pid
PENDING_DIR=$STATE_DIR/pending
BACKUP_DIR=$STATE_DIR/backups
INSTALL_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles-sync

log() {
    mkdir -p "$STATE_DIR"
    printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" | tee -a "$LOG_FILE"
}

die() { log "ERROR: $*" >&2; exit 1; }

tool_dir() {
    CDPATH='' cd -- "$(dirname "$0")/.." && pwd
}

show_help() {
    command=${1:-}
    case "$command" in
        '') ;;
        install) show_install_help; return ;;
        uninstall) show_uninstall_help; return ;;
        store) show_store_help; return ;;
        remove) show_remove_help; return ;;
        self-update|sync|check|apply|status|rollback|daemon)
            printf 'Usage: dotfiles-sync %s\n' "$command"
            return
            ;;
        *)
            printf 'Unknown command: %s\n' "$command" >&2
            exit 1
            ;;
    esac
    cat <<'EOF'
Usage: dotfiles-sync <command> [options]

Safely synchronize the configured Git-backed dotfiles checkout. Managed files
are stored at its repository root and applied to matching paths under $HOME.

Commands:
  install [OPTIONS]       Install or repair the CLI and user scheduler.
  uninstall [OPTIONS]     Remove the CLI, scheduler, and optional configuration.
  self-update             Download and install the latest CLI release.
  sync                    Fetch, fast-forward, stage managed files, and push.
  check                   Fetch metadata and report repository status only.
  apply                   Apply the staged revision to $HOME with a backup.
  status                  Show the configured repository and revision state.
  rollback [BACKUP]       Restore the latest backup, or BACKUP if specified.
  store [OPTIONS] PATH... Copy files from $HOME into the repository root and commit.
  remove [OPTIONS] PATH... Remove tracked files from the repository and commit.
  daemon                  Poll continuously in the foreground.
  help [COMMAND]          Show global or command-specific help.

Run `dotfiles-sync help COMMAND` or `dotfiles-sync COMMAND --help` for options.

Safety:
  sync stages changes but applies them only when APPLY_MODE=automatic; use apply
  for the default manual mode. self-update downloads and validates a CLI release;
  it never stages, applies, or pushes dotfiles. install is idempotent and repairs
  the CLI and scheduler.
EOF
    printf 'Configuration: %s\n' "$CONFIG_FILE"
    printf 'State and logs: %s\n' "$STATE_DIR"
}

show_store_help() {
    cat <<'EOF'
Usage: dotfiles-sync store [OPTIONS] PATH...

Copy regular files from $HOME into the managed repository root and commit them.

Options:
  -m, --message MESSAGE   Commit with MESSAGE.
  --dry-run               Preview required overwrite confirmation.
  --confirm-overwrite ID  Confirm the ID returned by --dry-run.
  --non-interactive       Do not prompt for a commit message or overwrite.
EOF
}

show_remove_help() {
    cat <<'EOF'
Usage: dotfiles-sync remove [OPTIONS] PATH...

Remove tracked regular files from the managed repository and commit the change.

Options:
  -m, --message MESSAGE   Commit with MESSAGE.
  --remove-original       Remove the matching file from $HOME after committing.
  --dry-run               Preview removal and print a confirmation token.
  --confirm-remove ID     Confirm the ID returned by --dry-run.
  --non-interactive       Do not prompt for a commit message or home-file removal.
EOF
}

show_install_help() {
    cat <<'EOF'
Usage: dotfiles-sync install [OPTIONS]

Install or repair the CLI and user scheduler.

Options (required only when no runtime config exists):
  -r, --remote URL        Dotfiles repository URL; prompted interactively if omitted.
  -b, --branch NAME       Dotfiles branch; defaults to the remote default branch.
EOF
}

show_uninstall_help() {
    cat <<'EOF'
Usage: dotfiles-sync uninstall [OPTIONS]

Remove the CLI, scheduler, state, and optionally runtime configuration.

Options:
  --keep-config           Remove the CLI and scheduler without prompting for config cleanup.
  --remove-config         Remove the CLI, scheduler, and runtime config without prompting.
EOF
}

load_config() {
    require_absolute_path CONFIG_FILE "$CONFIG_FILE"
    require_absolute_path CONFIG_DIR "$CONFIG_DIR"
    require_absolute_path STATE_DIR "$STATE_DIR"
    require_absolute_path INSTALL_DIR "$INSTALL_DIR"
    [ -r "$CONFIG_FILE" ] || die "missing config: $CONFIG_FILE (run: dotfiles-sync install)"
    # The config is shell syntax, but only values from the user's own file are sourced.
    # shellcheck disable=SC1090
    . "$CONFIG_FILE"
    : "${REMOTE:?REMOTE is required in $CONFIG_FILE}"
    if [ -z "${BRANCH+x}" ] || [ -z "$BRANCH" ]; then
        BRANCH=$(remote_default_branch "$REMOTE") || die "could not determine the default branch; set BRANCH in $CONFIG_FILE"
    fi
    : "${POLL_INTERVAL:=21600}"
    : "${APPLY_MODE:=manual}"
    : "${INTERACTIVE_AUTO_MESSAGE:=no}"
    case "$INTERACTIVE_AUTO_MESSAGE" in
        yes|no) ;;
        *) die "INTERACTIVE_AUTO_MESSAGE must be yes or no" ;;
    esac
    if [ "${DOTFILES_ROOT+x}" = x ]; then
        die "DOTFILES_ROOT is no longer supported; the managed repository root is fixed"
    fi
    : "${IGNORE_FILE:=$CONFIG_DIR/ignore}"
    require_absolute_path IGNORE_FILE "$IGNORE_FILE"
    if [ "${AFTER_APPLY_HOOK+x}" != x ]; then
        AFTER_APPLY_HOOK=$CONFIG_DIR/after-apply
    fi
    configure_after_apply_hook
    TOOL_DIR=$(tool_dir) || die "could not determine tool directory"
    REPO_DIR=$TOOL_DIR/dotfiles
}

require_absolute_path() {
    name=$1
    path=$2
    case "$path" in
        /*) ;;
        *) die "$name must be an absolute path: $path" ;;
    esac
}

configure_after_apply_hook() {
    case "$AFTER_APPLY_HOOK" in
        '') AFTER_APPLY_HOOK_RELATIVE= ;;
        "$HOME"/*) AFTER_APPLY_HOOK_RELATIVE=${AFTER_APPLY_HOOK#"$HOME"/} ;;
        /*) die "AFTER_APPLY_HOOK must be under HOME: $AFTER_APPLY_HOOK" ;;
        *)
            # Releases before v0.1.3 used a HOME-relative hook path.
            AFTER_APPLY_HOOK_RELATIVE=$AFTER_APPLY_HOOK
            AFTER_APPLY_HOOK=$HOME/$AFTER_APPLY_HOOK
            ;;
    esac
}

ensure_dotfiles_checkout() {
    if [ ! -d "$REPO_DIR/.git" ]; then
        [ ! -e "$REPO_DIR" ] || die "dotfiles directory is not a git checkout: $REPO_DIR"
        git clone --quiet --branch "$BRANCH" "$REMOTE" "$REPO_DIR"
        log "cloned dotfiles repository into $REPO_DIR"
    fi
    [ -d "$REPO_DIR" ] || die "managed files directory is missing: $REPO_DIR"
}

configured_paths() {
    git -C "$REPO_DIR" ls-files | while IFS= read -r path; do
        if ! ignored_path "$path"; then
            printf '%s\n' "$path"
        fi
    done
}

ignored_path() {
    path=$1
    [ -r "$IGNORE_FILE" ] || return 1
    basename=${path##*/}
    # Dynamic case patterns are intentional here; they implement ignore globs.
    # shellcheck disable=SC2125,SC2254
    while IFS= read -r pattern || [ -n "$pattern" ]; do
        case "$pattern" in
            ''|'#'*) continue ;;
            !*) die "negation rules are not supported in $IGNORE_FILE: $pattern" ;;
            */) pattern=${pattern%/}/* ;;
        esac
        case "$path" in
            $pattern) return 0 ;;
        esac
        case "$basename" in
            $pattern) return 0 ;;
        esac
    done < "$IGNORE_FILE"
    return 1
}

stage_files() {
    commit=$1
    stage=$PENDING_DIR/$commit
    rm -rf "$stage"
    mkdir -p "$stage"
    configured_paths | while IFS= read -r path; do
        source=$REPO_DIR/$path
        [ -e "$source" ] || die "configured file does not exist: $source"
        mkdir -p "$stage/$(dirname "$path")"
        cp -p "$source" "$stage/$path"
    done
    printf '%s\n' "$commit" > "$STATE_DIR/pending-commit"
    log "staged revision $commit"
}

validate_stage() {
    stage=$1
    configured_paths | while IFS= read -r path; do
        case "$path" in
            *.bash|*.bashrc|*.bash_aliases)
                if command -v bash >/dev/null 2>&1; then
                    bash -n "$stage/$path" || die "shell validation failed: $path"
                else
                    die "bash is required to validate: $path"
                fi
                ;;
            *.sh) sh -n "$stage/$path" || die "shell validation failed: $path" ;;
            *.zsh|*.zshrc)
                if command -v zsh >/dev/null 2>&1; then
                    zsh -n "$stage/$path" || die "shell validation failed: $path"
                fi
                ;;
        esac
    done
    validate_after_apply_hook "$stage"
}

validate_after_apply_hook() {
    stage=$1
    [ -n "$AFTER_APPLY_HOOK_RELATIVE" ] || return 0
    hook=$stage/$AFTER_APPLY_HOOK_RELATIVE
    [ ! -e "$hook" ] && return 0
    [ -f "$hook" ] || die "after-apply hook is not a regular file: $AFTER_APPLY_HOOK_RELATIVE"
    sh -n "$hook" || die "after-apply hook validation failed: $AFTER_APPLY_HOOK_RELATIVE"
}

after_apply_hook_is_tracked() {
    [ -n "$AFTER_APPLY_HOOK_RELATIVE" ] \
        && git -C "$REPO_DIR" ls-files --error-unmatch -- "$AFTER_APPLY_HOOK_RELATIVE" >/dev/null 2>&1 \
        && ! ignored_path "$AFTER_APPLY_HOOK_RELATIVE"
}

run_after_apply_hook() {
    [ -n "$AFTER_APPLY_HOOK_RELATIVE" ] || return 0
    after_apply_hook_is_tracked || return 0
    hook=$AFTER_APPLY_HOOK
    [ ! -e "$hook" ] && return 0
    [ -f "$hook" ] || die "after-apply hook is not a regular file: $AFTER_APPLY_HOOK_RELATIVE"
    log "running after-apply hook: $AFTER_APPLY_HOOK_RELATIVE"
    DOTFILES_SYNC_REPO_DIR=$REPO_DIR DOTFILES_SYNC_REVISION=$commit sh "$hook"
    log "completed after-apply hook: $AFTER_APPLY_HOOK"
}

apply_pending() {
    load_config
    [ -r "$STATE_DIR/pending-commit" ] || die "no pending update"
    commit=$(cat "$STATE_DIR/pending-commit")
    stage=$PENDING_DIR/$commit
    [ -d "$stage" ] || die "pending snapshot is missing: $stage"
    validate_stage "$stage"
    timestamp=$(date '+%Y%m%d%H%M%S')
    backup=$BACKUP_DIR/$timestamp
    mkdir -p "$backup"
    configured_paths | while IFS= read -r path; do
        target=$HOME/$path
        if [ -e "$target" ]; then
            mkdir -p "$backup/$(dirname "$path")"
            cp -p "$target" "$backup/$path"
        fi
    done
    configured_paths | while IFS= read -r path; do
        target=$HOME/$path
        temp=$target.dotfiles-sync.$$
        mkdir -p "$(dirname "$target")"
        cp -p "$stage/$path" "$temp"
    done
    configured_paths | while IFS= read -r path; do
        target=$HOME/$path
        temp=$target.dotfiles-sync.$$
        mv "$temp" "$target"
        log "applied $path"
    done
    printf '%s\n' "$commit" > "$STATE_DIR/applied-commit"
    rm -f "$STATE_DIR/pending-commit"
    rm -rf "$stage"
    log "applied revision $commit; backup: $backup"
    run_after_apply_hook
}

show_status() {
    load_config
    printf 'Repository: %s\n' "$REPO_DIR"
    printf 'Apply mode: %s\n' "$APPLY_MODE"
    printf 'Applied: %s\n' "$(cat "$STATE_DIR/applied-commit" 2>/dev/null || printf 'none')"
    printf 'Pending: %s\n' "$(cat "$STATE_DIR/pending-commit" 2>/dev/null || printf 'none')"
}

rollback() {
    load_config
    backup=${1:-}
    if [ -z "$backup" ]; then
        for candidate in "$BACKUP_DIR"/*; do
            [ -d "$candidate" ] || continue
            backup=${candidate##*/}
        done
    fi
    if [ -z "$backup" ] || [ ! -d "$BACKUP_DIR/$backup" ]; then
        die "no backup available"
    fi
    configured_paths | while IFS= read -r path; do
        [ -e "$BACKUP_DIR/$backup/$path" ] || continue
        target=$HOME/$path
        mkdir -p "$(dirname "$target")"
        cp -p "$BACKUP_DIR/$backup/$path" "$target"
        log "restored $path"
    done
    log "rolled back from backup $backup"
}

store_path() {
    input=$1
    home_real=$(CDPATH=; cd -P "$HOME" && pwd)
    if [ "${input#/}" = "$input" ]; then
        input=$PWD/$input
    fi
    source_dir=$(CDPATH=; cd -P "$(dirname "$input")" 2>/dev/null && pwd) || die "path does not exist: $1"
    source=$source_dir/$(basename "$input")
    [ -e "$source" ] || die "path does not exist: $1"
    [ -f "$source" ] || die "not a regular file: $1"
    case "$source" in
        "$home_real"/*) relative=${source#"$home_real"/} ;;
        *) die "store accepts only files under HOME: $1" ;;
    esac
    if ignored_path "$relative"; then
        log "skipped ignored path: $relative"
        return 0
    fi
    target=$REPO_DIR/$relative
    printf '%s\t%s\n' "$relative" "$source" >> "$STORE_PLAN"
    if [ -e "$target" ] && ! cmp -s "$source" "$target"; then
        printf '%s\n' "$relative" >> "$STORE_OVERWRITES"
    fi
}

store() {
    load_config
    ensure_dotfiles_checkout
    message=
    dry_run=no
    confirm_token=
    non_interactive=no
    paths_file=$STATE_DIR/store-paths.$$
    STORE_PLAN=$STATE_DIR/store-plan.$$
    STORE_OVERWRITES=$STATE_DIR/store-overwrites.$$
    STORE_FILES=$STATE_DIR/store-files.$$
    trap 'rm -f "$paths_file" "$STORE_PLAN" "$STORE_OVERWRITES" "$STORE_FILES" "$paths_file.files"' 0 1 2 3 15
    : > "$paths_file"
    : > "$STORE_PLAN"
    : > "$STORE_OVERWRITES"
    : > "$STORE_FILES"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --message|-m)
                [ "$#" -ge 2 ] || die "$1 requires a message"
                message=$2
                shift 2
                ;;
            --confirm-overwrite)
                [ "$#" -ge 2 ] || die "--confirm-overwrite requires a signature"
                confirm_token=$2
                shift 2
                ;;
            --dry-run)
                dry_run=yes
                shift
                ;;
            --non-interactive)
                non_interactive=yes
                shift
                ;;
            --)
                shift
                while [ "$#" -gt 0 ]; do
                    printf '%s\n' "$1" >> "$paths_file"
                    shift
                done
                ;;
            -*) die "unknown store option: $1" ;;
            *) printf '%s\n' "$1" >> "$paths_file"; shift ;;
        esac
    done
    [ -s "$paths_file" ] || die "store requires at least one path"
    [ -z "$(git -C "$REPO_DIR" status --porcelain)" ] || die "local changes found in $REPO_DIR; refusing to mix store changes"

    while IFS= read -r input; do
        [ -n "$input" ] || continue
        if [ -d "$input" ]; then
            find "$input" -type f -print >> "$paths_file.files"
        else
            store_path "$input"
        fi
    done < "$paths_file"
    if [ -r "$paths_file.files" ]; then
        while IFS= read -r input; do
            store_path "$input"
        done < "$paths_file.files"
        rm -f "$paths_file.files"
    fi
    [ -s "$STORE_PLAN" ] || die "no files were stored"
    overwrite_token=
    if [ -s "$STORE_OVERWRITES" ]; then
        checksum=$(cksum "$STORE_OVERWRITES" | cut -d ' ' -f 1)
        overwrite_token="dotfiles-sync-overwrite-$checksum"
        if [ "$dry_run" = yes ]; then
            printf 'OVERWRITE_TOKEN=%s\n' "$overwrite_token"
            printf 'Files requiring overwrite:\n'
            cat "$STORE_OVERWRITES"
            return 0
        fi
        if [ "$non_interactive" = yes ] || [ ! -t 0 ] || [ ! -t 1 ]; then
            [ "$confirm_token" = "$overwrite_token" ] || die "overwrite requires --confirm-overwrite $overwrite_token (run --dry-run first)"
        else
            while IFS= read -r relative; do
                target=$REPO_DIR/$relative
                printf 'Overwrite %s? [y/N] ' "$target" > /dev/tty
                read -r answer < /dev/tty || die "cannot read overwrite confirmation"
                case "$answer" in
                    y|Y|yes|YES) ;;
                    *) die "overwrite declined: $relative" ;;
                esac
            done < "$STORE_OVERWRITES"
        fi
    elif [ "$dry_run" = yes ]; then
        printf '%s\n' 'No overwrite required.'
        return 0
    elif [ -n "$confirm_token" ]; then
        die "--confirm-overwrite is only valid when an overwrite is required"
    fi
    if [ -z "$message" ] && { [ "$non_interactive" = yes ] || [ ! -t 0 ] || [ ! -t 1 ]; }; then
        die "non-interactive store requires --message"
    fi
    if [ -z "$message" ]; then
        if [ "$INTERACTIVE_AUTO_MESSAGE" = yes ]; then
            files=$(cut -f 1 "$STORE_PLAN" | tr '\n' ' ')
            message="Updates ${files% }"
        else
            printf 'Commit message: ' > /dev/tty
            read -r message < /dev/tty || die "cannot read commit message"
            [ -n "$message" ] || die "commit message cannot be empty"
        fi
    fi
    while IFS= read -r plan_line; do
        relative=$(printf '%s\n' "$plan_line" | cut -f 1)
        source=$(printf '%s\n' "$plan_line" | cut -f 2-)
        target=$REPO_DIR/$relative
        mkdir -p "$(dirname "$target")"
        cp -p "$source" "$target"
        printf '%s\n' "$relative" >> "$STORE_FILES"
    done < "$STORE_PLAN"
    while IFS= read -r relative; do
        git -C "$REPO_DIR" add -- "$relative"
    done < "$STORE_FILES"
    git -C "$REPO_DIR" commit -m "$message"
    log "stored and committed files; push the repository separately to synchronize other machines"
}

remove_path() {
    input=$1
    home_real=$(CDPATH=; cd -P "$HOME" && pwd)
    if [ "${input#/}" = "$input" ]; then
        input=$PWD/$input
    fi
    source_dir=$(CDPATH=; cd -P "$(dirname "$input")" 2>/dev/null && pwd) || die "path does not exist: $1"
    source=$source_dir/$(basename "$input")
    case "$source" in
        "$home_real"/*) relative=${source#"$home_real"/} ;;
        *) die "remove accepts only paths under HOME: $1" ;;
    esac
    git -C "$REPO_DIR" ls-files --error-unmatch -- "$relative" >/dev/null 2>&1 \
        || die "path is not tracked: $relative"
    [ -f "$REPO_DIR/$relative" ] || die "tracked path is not a regular file: $relative"
    if [ "$REMOVE_ORIGINAL" = yes ]; then
        [ -f "$source" ] || die "original file is not a regular file: $1"
    fi
    printf '%s\t%s\n' "$relative" "$source" >> "$REMOVE_PLAN"
}

remove() {
    load_config
    ensure_dotfiles_checkout
    message=
    dry_run=no
    confirm_token=
    non_interactive=no
    REMOVE_ORIGINAL=no
    tab=$(printf '\t')
    mkdir -p "$STATE_DIR"
    paths_file=$STATE_DIR/remove-paths.$$
    REMOVE_PLAN=$STATE_DIR/remove-plan.$$
    trap 'rm -f "$paths_file" "$REMOVE_PLAN"' 0 1 2 3 15
    : > "$paths_file"
    : > "$REMOVE_PLAN"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --message|-m)
                [ "$#" -ge 2 ] || die "$1 requires a message"
                message=$2
                shift 2
                ;;
            --remove-original)
                REMOVE_ORIGINAL=yes
                shift
                ;;
            --confirm-remove)
                [ "$#" -ge 2 ] || die "--confirm-remove requires a token"
                confirm_token=$2
                shift 2
                ;;
            --dry-run)
                dry_run=yes
                shift
                ;;
            --non-interactive)
                non_interactive=yes
                shift
                ;;
            --)
                shift
                while [ "$#" -gt 0 ]; do
                    printf '%s\n' "$1" >> "$paths_file"
                    shift
                done
                ;;
            -*) die "unknown remove option: $1" ;;
            *) printf '%s\n' "$1" >> "$paths_file"; shift ;;
        esac
    done
    [ -s "$paths_file" ] || die "remove requires at least one path"
    [ -z "$(git -C "$REPO_DIR" status --porcelain)" ] || die "local changes found in $REPO_DIR; refusing to mix removal changes"
    while IFS= read -r input; do
        [ -n "$input" ] || continue
        remove_path "$input"
    done < "$paths_file"
    [ -s "$REMOVE_PLAN" ] || die "no tracked files were selected"
    if [ "$REMOVE_ORIGINAL" = yes ]; then
        checksum=$(cksum "$REMOVE_PLAN" | cut -d ' ' -f 1)
        remove_token="dotfiles-sync-remove-$checksum"
        if [ "$dry_run" = yes ]; then
            printf 'REMOVE_TOKEN=%s\n' "$remove_token"
            printf 'Files to remove from the repository and HOME:\n'
            cut -f 1 "$REMOVE_PLAN"
            return 0
        fi
        if [ "$non_interactive" = yes ] || [ ! -t 0 ] || [ ! -t 1 ]; then
            [ "$confirm_token" = "$remove_token" ] || die "home removal requires --confirm-remove $remove_token (run --dry-run first)"
        else
            while IFS="$tab" read -r relative source; do
                printf 'Remove %s from HOME after committing? [y/N] ' "$source" > /dev/tty
                read -r answer < /dev/tty || die "cannot read removal confirmation"
                case "$answer" in
                    y|Y|yes|YES) ;;
                    *) die "home removal declined: $relative" ;;
                esac
            done < "$REMOVE_PLAN"
        fi
    elif [ "$dry_run" = yes ]; then
        printf 'Files to remove from the repository:\n'
        cut -f 1 "$REMOVE_PLAN"
        return 0
    elif [ -n "$confirm_token" ]; then
        die "--confirm-remove is only valid with --remove-original"
    fi
    if [ -z "$message" ] && { [ "$non_interactive" = yes ] || [ ! -t 0 ] || [ ! -t 1 ]; }; then
        die "non-interactive remove requires --message"
    fi
    if [ -z "$message" ]; then
        if [ "$INTERACTIVE_AUTO_MESSAGE" = yes ]; then
            files=$(cut -f 1 "$REMOVE_PLAN" | tr '\n' ' ')
            message="Removes ${files% }"
        else
            printf 'Commit message: ' > /dev/tty
            read -r message < /dev/tty || die "cannot read commit message"
            [ -n "$message" ] || die "commit message cannot be empty"
        fi
    fi
    if [ "$REMOVE_ORIGINAL" = yes ]; then
        timestamp=$(date '+%Y%m%d%H%M%S')
        backup=$BACKUP_DIR/removals/$timestamp
        while IFS="$tab" read -r relative source; do
            mkdir -p "$backup/$(dirname "$relative")"
            cp -p "$source" "$backup/$relative"
        done < "$REMOVE_PLAN"
    fi
    while IFS="$tab" read -r relative source; do
        git -C "$REPO_DIR" rm -- "$relative"
    done < "$REMOVE_PLAN"
    git -C "$REPO_DIR" commit -m "$message"
    if [ "$REMOVE_ORIGINAL" = yes ]; then
        while IFS="$tab" read -r relative source; do
            rm "$source"
            log "removed original $relative"
        done < "$REMOVE_PLAN"
        log "removed and committed files; original backup: $backup"
    else
        log "removed and committed files; original files were retained"
    fi
}

check_once() {
    load_config
    [ -d "$REPO_DIR/.git" ] || die "REPO_DIR is not a git checkout: $REPO_DIR"
    [ -d "$REPO_DIR" ] || die "managed files directory is missing: $REPO_DIR"
    cd "$REPO_DIR"
    [ -z "$(git status --porcelain)" ] || die "local changes found in $REPO_DIR; refusing to overwrite them"
    git fetch --quiet origin "$BRANCH"
    local_head=$(git rev-parse HEAD)
    remote_head=$(git rev-parse "origin/$BRANCH")
    if [ "$local_head" = "$remote_head" ]; then
        log "up to date: $local_head"
    elif git merge-base --is-ancestor HEAD "origin/$BRANCH"; then
        log "remote has updates: local=$local_head remote=$remote_head"
    elif git merge-base --is-ancestor "origin/$BRANCH" HEAD; then
        log "local has unpushed commits: local=$local_head remote=$remote_head"
    else
        die "local and remote histories diverged; resolve manually in $REPO_DIR"
    fi
}

sync_once() {
    load_config
    ensure_dotfiles_checkout
    cd "$REPO_DIR"
    [ -z "$(git status --porcelain)" ] || die "local changes found in $REPO_DIR; refusing to synchronize"
    git fetch --quiet origin "$BRANCH"
    local_head=$(git rev-parse HEAD)
    remote_head=$(git rev-parse "origin/$BRANCH")
    if [ "$local_head" != "$remote_head" ]; then
        if git merge-base --is-ancestor HEAD "origin/$BRANCH"; then
            git merge --ff-only --quiet "origin/$BRANCH"
            commit=$(git rev-parse HEAD)
            stage_files "$commit"
            validate_stage "$PENDING_DIR/$commit"
            if [ "$APPLY_MODE" = automatic ]; then
                apply_pending
            elif [ "$APPLY_MODE" != manual ] && [ "$APPLY_MODE" != prompt ]; then
                die "APPLY_MODE must be manual, prompt, or automatic"
            fi
            log "pulled and staged revision $commit"
        elif ! git merge-base --is-ancestor "origin/$BRANCH" HEAD; then
            die "local and remote histories diverged; resolve manually in $REPO_DIR"
        fi
    fi
    local_head=$(git rev-parse HEAD)
    remote_head=$(git rev-parse "origin/$BRANCH")
    if [ "$local_head" != "$remote_head" ]; then
        git push --quiet origin "HEAD:$BRANCH"
        log "pushed revision $local_head"
    else
        log "synchronized at revision $local_head"
    fi
}

deploy_tool_source() {
    source_dir=$1
    [ -f "$source_dir/bin/dotfiles-sync" ] || die "release is missing bin/dotfiles-sync"
    [ -r "$source_dir/.release-url" ] || die "release is missing .release-url"
    [ "$source_dir" = "$INSTALL_DIR" ] && return 0
    install_parent=$(dirname "$INSTALL_DIR")
    staging=$INSTALL_DIR.install.$$
    previous=$INSTALL_DIR.previous.$$
    mkdir -p "$install_parent"
    rm -rf "$staging" "$previous"
    mkdir -p "$staging"
    if git -C "$source_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git -C "$source_dir" archive --format=tar HEAD | tar -xf - -C "$staging"
    else
        cp -R "$source_dir"/. "$staging"
    fi
    sh -n "$staging/bin/dotfiles-sync" || die "release shell validation failed"
    [ -r "$staging/.release-url" ] || die "release is missing .release-url"
    if [ -d "$INSTALL_DIR" ]; then
        mv "$INSTALL_DIR" "$previous" || die "could not preserve current installation"
    fi
    if ! mv "$staging" "$INSTALL_DIR"; then
        [ ! -d "$previous" ] || mv "$previous" "$INSTALL_DIR"
        die "could not install release"
    fi
    rm -rf "$previous"
}

install_command() {
    command_dir=$HOME/.local/bin
    command_path=$command_dir/dotfiles-sync
    command_tmp=$command_dir/.dotfiles-sync.$$
    mkdir -p "$command_dir"
    cat >"$command_tmp" <<EOF
#!/bin/sh
exec "$INSTALL_DIR/bin/dotfiles-sync" "\$@"
EOF
    chmod 755 "$command_tmp"
    mv "$command_tmp" "$command_path"
}

self_update() {
    TOOL_DIR=$(tool_dir) || die "could not determine tool directory"
    release_url=$(cat "$TOOL_DIR/.release-url" 2>/dev/null) || die "release URL is missing: $TOOL_DIR/.release-url"
    case "$release_url" in
        https://*) ;;
        *) die "release URL must use HTTPS: $release_url" ;;
    esac
    update_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-sync-update.XXXXXX") || die "could not create update directory"
    trap 'rm -rf "$update_dir"' 0 1 2 3 15
    release_dir=$("$TOOL_DIR/bin/install-dotfiles-sync" --download-release "$release_url" "$update_dir") \
        || die "could not download latest release"
    package_version=$(release_directory_version "$release_dir")
    installed_version=$(installed_release_version)
    if version_major_distance_exceeds_two "$package_version" "$installed_version"; then
        die "self-update across more than two major versions requires installing an intermediate release"
    fi
    if version_is_greater "$package_version" "$installed_version"; then
        run_migrations "$release_dir" "$update_dir"
        deploy_tool_source "$release_dir"
        update_result=updated
    else
        update_result=current
    fi
    install_command
    trap - 0 1 2 3 15
    rm -rf "$update_dir"
    case "$update_result" in
        updated) log "updated CLI to $package_version" ;;
        *)
            if version_is_greater "$installed_version" "$package_version"; then
                log "installed CLI $installed_version is newer than latest published $package_version; not downgrading"
            else
                log "CLI is already up to date ($installed_version)"
            fi
            ;;
    esac
}

release_directory_version() {
    release_dir=$1
    fallback_version=${2:-v0.0.0}
    if [ -r "$release_dir/.release-version" ]; then
        release_version=$(cat "$release_dir/.release-version")
        release_version_is_valid "$release_version" || die "release has an invalid version: $release_version"
        printf '%s\n' "$release_version"
    else
        printf '%s\n' "$fallback_version"
    fi
}

installed_release_version() {
    release_directory_version "$INSTALL_DIR"
}

release_version_is_valid() {
    release_candidate=${1#v}
    case "$1" in
        v*) ;;
        *) return 1 ;;
    esac
    case "$release_candidate" in
        ''|.*|*..*|*.|*.*.*.*|*[!0-9.]*) return 1 ;;
    esac
}

version_parts() {
    version=${1#v}
    major=${version%%.*}
    remainder=${version#*.}
    if [ "$remainder" = "$version" ]; then
        printf '%s 0 0\n' "$major"
        return
    fi
    minor=${remainder%%.*}
    patch=${remainder#*.}
    if [ "$patch" = "$remainder" ]; then
        patch=0
    fi
    printf '%s %s %s\n' "$major" "$minor" "$patch"
}

version_is_greater() {
    candidate=$1
    current=$2
    # version_parts produces three trusted numeric fields.
    # shellcheck disable=SC2046
    set -- $(version_parts "$candidate")
    candidate_major=$1 candidate_minor=$2 candidate_patch=$3
    # shellcheck disable=SC2046
    set -- $(version_parts "$current")
    current_major=$1 current_minor=$2 current_patch=$3
    [ "$candidate_major" -gt "$current_major" ] && return 0
    [ "$candidate_major" -lt "$current_major" ] && return 1
    [ "$candidate_minor" -gt "$current_minor" ] && return 0
    [ "$candidate_minor" -lt "$current_minor" ] && return 1
    [ "$candidate_patch" -gt "$current_patch" ]
}

version_major_distance_exceeds_two() {
    # shellcheck disable=SC2046
    set -- $(version_parts "$1")
    target_major=$1
    # shellcheck disable=SC2046
    set -- $(version_parts "$2")
    installed_major=$1
    [ $((target_major - installed_major)) -gt 2 ]
}

run_migrations() {
    release_dir=$1
    work_dir=$2
    migration_dir=$release_dir/.config/dotfiles-sync/migrations
    migration_order=$work_dir/migration-order
    [ -d "$migration_dir" ] || return 0
    : > "$migration_order"
    for migration in "$migration_dir"/*.sh; do
        [ -f "$migration" ] || continue
        name=$(basename "$migration")
        case "$name" in
            v[0-9]*.[0-9]*.[0-9]*.sh) ;;
            *) die "migration names must use vMAJOR.MINOR.PATCH.sh: $name" ;;
        esac
        marker=$STATE_DIR/migrations/$name.done
        [ ! -e "$marker" ] || continue
        version=${name#v}
        version=${version%.sh}
        key=$(printf '%s\n' "$version" | awk -F. '{ printf "%09d.%09d.%09d", $1, $2, $3 }')
        printf '%s\t%s\n' "$key" "$migration" >> "$migration_order"
    done
    [ -s "$migration_order" ] || return 0
    timestamp=$(date '+%Y%m%d%H%M%S')
    backup=$STATE_DIR/migration-backups/$timestamp
    mkdir -p "$backup" "$STATE_DIR/migrations"
    if [ -d "$CONFIG_DIR" ]; then
        cp -Rp "$CONFIG_DIR" "$backup/config"
    fi
    tab=$(printf '\t')
    sort "$migration_order" | while IFS="$tab" read -r _ migration; do
        name=$(basename "$migration")
        sh -n "$migration" || die "migration shell validation failed: $name"
        DOTFILES_SYNC_CONFIG_FILE=$CONFIG_FILE \
            DOTFILES_SYNC_CONFIG_DIR=$CONFIG_DIR \
            DOTFILES_SYNC_STATE_DIR=$STATE_DIR \
            sh "$migration" || die "migration failed: $name (config backup: $backup)"
        : > "$STATE_DIR/migrations/$name.done"
        log "applied migration $name"
    done
}

remote_default_branch() {
    # shellcheck disable=SC2046
    set -- $(git ls-remote --symref "$1" HEAD 2>/dev/null)
    [ "${1:-}" = ref: ] && [ "${3:-}" = HEAD ] || return 1
    case "$2" in
        refs/heads/*) printf '%s\n' "${2#refs/heads/}" ;;
        *) return 1 ;;
    esac
}

install_sync() {
    require_absolute_path CONFIG_FILE "$CONFIG_FILE"
    require_absolute_path CONFIG_DIR "$CONFIG_DIR"
    require_absolute_path STATE_DIR "$STATE_DIR"
    require_absolute_path INSTALL_DIR "$INSTALL_DIR"
    remote=
    branch=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -r|--remote)
                [ "$#" -ge 2 ] || die "$1 requires a repository URL"
                remote=$2
                shift 2
                ;;
            -b|--branch)
                [ "$#" -ge 2 ] || die "$1 requires a branch name"
                branch=$2
                shift 2
                ;;
            *) die "unknown install option: $1" ;;
        esac
    done
    if [ ! -r "$CONFIG_FILE" ]; then
        if [ -z "$remote" ] && [ -t 0 ] && [ -t 1 ]; then
            printf 'Dotfiles repository URL: ' > /dev/tty
            read -r remote < /dev/tty || die "cannot read dotfiles repository URL"
        fi
        [ -n "$remote" ] || die "install requires --remote URL when $CONFIG_FILE does not exist"
        if [ -z "$branch" ]; then
            branch=$(remote_default_branch "$remote") || die "could not determine the default branch; rerun with --branch NAME"
        fi
    elif [ -n "$remote" ] || [ -n "$branch" ]; then
        die "runtime config already exists; edit REMOTE or BRANCH in $CONFIG_FILE"
    else
        log "WARNING: using existing configuration: $CONFIG_FILE"
    fi
    config_dir=$(dirname "$CONFIG_FILE")
    mkdir -p "$config_dir" "$STATE_DIR" "$HOME/.local/bin"
    repo_dir=$(tool_dir) || die "could not determine tool directory"
    deploy_tool_source "$repo_dir"
    ignore_example=$INSTALL_DIR/.config/dotfiles-sync/ignore.example
    install_command
    if [ ! -r "$CONFIG_FILE" ]; then
        cat >"$CONFIG_FILE" <<EOF
# dotfiles-sync configuration for the managed dotfiles repository.
REMOTE=$remote
BRANCH=$branch
POLL_INTERVAL=21600
APPLY_MODE=manual
# Generate store/remove commit messages only for interactive terminal sessions.
INTERACTIVE_AUTO_MESSAGE=no
IGNORE_FILE=$config_dir/ignore
# Run this managed hook after a successful apply; set empty to disable it.
AFTER_APPLY_HOOK=$config_dir/after-apply
EOF
        log "created $CONFIG_FILE"
    fi
    if [ ! -r "$config_dir/ignore" ] && [ -r "$ignore_example" ]; then
        cp "$ignore_example" "$config_dir/ignore"
        log "created $config_dir/ignore"
    fi
    load_config
    log "installed $HOME/.local/bin/dotfiles-sync"
    install_service "$INSTALL_DIR"
}

uninstall_sync() {
    config_cleanup=prompt
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --keep-config) config_cleanup=no ;;
            --remove-config) config_cleanup=yes ;;
            *) die "unknown uninstall option: $1" ;;
        esac
        shift
    done
    if [ "$config_cleanup" = prompt ]; then
        if [ -t 0 ] && [ -t 1 ]; then
            printf 'Remove %s? [y/N] ' "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles-sync" > /dev/tty
            read -r answer < /dev/tty || die "cannot read configuration cleanup confirmation"
            case "$answer" in
                y|Y|yes|YES) config_cleanup=yes ;;
                *) config_cleanup=no ;;
            esac
        else
            config_cleanup=no
        fi
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemctl --user disable --now dotfiles-sync.timer >/dev/null 2>&1 || true
        rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/dotfiles-sync.service" \
            "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/dotfiles-sync.timer"
        systemctl --user daemon-reload >/dev/null 2>&1 || true
    fi
    if command -v launchctl >/dev/null 2>&1; then
        launchctl bootout "gui/$(id -u)/com.dotfiles.sync" >/dev/null 2>&1 || true
        rm -f "$HOME/Library/LaunchAgents/com.dotfiles.sync.plist"
    fi
    if command -v crontab >/dev/null 2>&1; then
        cron_line="$HOME/.local/bin/dotfiles-sync sync"
        existing=$(crontab -l 2>/dev/null || true)
        case "$existing" in
            *"$cron_line"*)
                filtered=$(printf '%s\n' "$existing" | grep -F -v "$cron_line" || true)
                printf '%s\n' "$filtered" | crontab -
                ;;
        esac
    fi
    if [ -r "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        case "$pid" in
            ''|*[!0-9]*) ;;
            *) kill "$pid" >/dev/null 2>&1 || true ;;
        esac
    fi
    rm -f "$HOME/.local/bin/dotfiles-sync"
    rm -rf "$INSTALL_DIR" "$STATE_DIR"
    if [ "$config_cleanup" = yes ]; then
        rm -rf "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles-sync"
    elif [ -e "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles-sync" ]; then
        printf 'Configuration retained: %s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles-sync"
    fi
    printf '%s\n' 'dotfiles-sync uninstalled'
}

install_service() {
    repo_root=$1
    os=$(uname -s)

    if [ "$os" = Linux ] && command -v systemctl >/dev/null 2>&1 \
        && systemctl --user show-environment >/dev/null 2>&1; then
        service_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
        mkdir -p "$service_dir"
        cp "$repo_root/systemd/dotfiles-sync.service" "$service_dir/"
        cp "$repo_root/systemd/dotfiles-sync.timer" "$service_dir/"
        systemctl --user daemon-reload
        systemctl --user enable --now dotfiles-sync.timer
        log "enabled systemd user timer (every ${POLL_INTERVAL}s)"
        return 0
    fi

    if [ "$os" = Darwin ] && command -v launchctl >/dev/null 2>&1; then
        launch_agent_dir=$HOME/Library/LaunchAgents
        launch_agent=$launch_agent_dir/com.dotfiles.sync.plist
        mkdir -p "$launch_agent_dir"
        cat >"$launch_agent" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.dotfiles.sync</string>
  <key>ProgramArguments</key><array><string>$HOME/.local/bin/dotfiles-sync</string><string>sync</string></array>
  <key>StartInterval</key><integer>$POLL_INTERVAL</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict></plist>
EOF
        launchctl bootout "gui/$(id -u)/com.dotfiles.sync" >/dev/null 2>&1 || true
        launchctl bootstrap "gui/$(id -u)" "$launch_agent"
        log "enabled launchd agent (every ${POLL_INTERVAL}s)"
        return 0
    fi

    if command -v crontab >/dev/null 2>&1; then
        cron_minutes=$((POLL_INTERVAL / 60))
        if [ "$cron_minutes" -lt 1 ]; then
            start_background_daemon
            return 0
        fi
        cron_line="*/$cron_minutes * * * * $HOME/.local/bin/dotfiles-sync sync >>$LOG_FILE 2>&1"
        existing=$(crontab -l 2>/dev/null || true)
        case "\n$existing\n" in
            *"\n$HOME/.local/bin/dotfiles-sync sync "*) ;;
            *) printf '%s\n%s\n' "$existing" "$cron_line" | crontab - ;;
        esac
        log "enabled user cron job (every $cron_minutes minutes)"
        return 0
    fi

    start_background_daemon
}

start_background_daemon() {
    if [ -r "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            log "background daemon already running (pid $pid)"
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    nohup "$HOME/.local/bin/dotfiles-sync" daemon >>"$LOG_FILE" 2>&1 </dev/null &
    pid=$!
    printf '%s\n' "$pid" >"$PID_FILE"
    log "started background daemon (pid $pid; it must be restarted after the environment restarts)"
}

daemon() {
    load_config
    while :; do
        sync_once || log "sync failed; retrying in ${POLL_INTERVAL}s"
        sleep "$POLL_INTERVAL"
    done
}

case "${1:-sync}" in
    --help|-h) show_help ;;
    help) shift; show_help "${1:-}" ;;
    install)
        shift
        case "${1:-}" in --help|-h) show_install_help ;; *) install_sync "$@" ;; esac
        ;;
    uninstall)
        shift
        case "${1:-}" in --help|-h) show_uninstall_help ;; *) uninstall_sync "$@" ;; esac
        ;;
    self-update) self_update ;;
    sync) sync_once ;;
    check) check_once ;;
    apply) apply_pending ;;
    status) show_status ;;
    rollback) rollback "${2:-}" ;;
    store)
        shift
        case "${1:-}" in --help|-h) show_store_help ;; *) store "$@" ;; esac
        ;;
    remove)
        shift
        case "${1:-}" in --help|-h) show_remove_help ;; *) remove "$@" ;; esac
        ;;
    daemon) daemon ;;
    *) die "unknown command: $1 (run: dotfiles-sync --help)" ;;
esac
