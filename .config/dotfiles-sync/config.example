# Copy to ~/.config/dotfiles-sync/config, or run:
# bin/dotfiles-sync install --remote URL [--branch NAME]
REMOTE="git@github.com:YOUR_USER/dotfiles.git"
# Set this to a preferred branch. install detects the remote default when omitted.
BRANCH=
POLL_INTERVAL=21600
# Apply staged remote changes during sync; otherwise run `dotfiles-sync apply`.
SYNC_APPLY_MODE=manual
# Push a successful store commit immediately; otherwise sync pushes it later.
STORE_PUSH_MODE=manual
# Generate store/remove commit messages only for interactive terminal sessions.
INTERACTIVE_AUTO_MESSAGE=no
# Path values are POSIX shell expressions and must expand to absolute paths.
# Example fallback syntax: ${HOME:-/test}/.config/dotfiles-sync/ignore
IGNORE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles-sync/ignore"
# Run this managed hook after a successful apply; set empty to disable it.
AFTER_APPLY_HOOK="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles-sync/after-apply"
